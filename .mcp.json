{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "codex-implementer": {
      "type": "stdio",
      "command": "codex",
      "args": ["mcp-server"],
      "env": {}
    }
  }
}
