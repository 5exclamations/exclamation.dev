---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Why from '../components/Why.astro';
import Work from '../components/Work.astro';
import Metrics from '../components/Metrics.astro';
import Process from '../components/Process.astro';
import Tech from '../components/Tech.astro';
import Facts from '../components/Facts.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import FinalCta from '../components/FinalCta.astro';
import { t } from '../i18n';

const locale = 'az' as const;
const dict = t(locale);
---

<Base locale={locale} dict={dict}>
  <Hero dict={dict} />
  <Services dict={dict} />
  <Why dict={dict} />
  <Work locale={locale} dict={dict} />
  <Metrics dict={dict} />
  <Process dict={dict} />
  <Tech dict={dict} />
  <Facts dict={dict} />
  <Faq dict={dict} />
  <Contact dict={dict} />
  <FinalCta dict={dict} />
</Base>
