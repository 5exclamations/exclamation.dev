---
import Base from '../../../layouts/Base.astro';
import ServicePage from '../../../components/ServicePage.astro';
import { ecommerce } from '../../../i18n/services/ecommerce';
import { serviceAlternates } from '../../../data/services';
import { t } from '../../../i18n';

const locale = 'en' as const;
const dict = t(locale);
const copy = ecommerce[locale];
---

<Base
  locale={locale}
  dict={dict}
  meta={copy.meta}
  ogKey="service-ecommerce"
  schemaKind="service"
  faq={copy.faq.items}
  alternates={serviceAlternates('ecommerce')}
>
  <ServicePage locale={locale} dict={dict} copy={copy} serviceKey="ecommerce" />
</Base>
