---
import Base from '../../layouts/Base.astro';
import NotFound from '../../components/NotFound.astro';
import { t } from '../../i18n';

const locale = 'en' as const;
const dict = t(locale);
---

<Base
  locale={locale}
  dict={dict}
  noindex
  meta={{
    title: '404 — page not found | EXCLAMATION',
    description: 'No such page. Go back to the home page or look at the work.',
  }}
>
  <NotFound locale={locale} dict={dict} />
</Base>
