---
import Base from '../../layouts/Base.astro';
import NotFound from '../../components/NotFound.astro';
import { t } from '../../i18n';

const locale = 'ru' as const;
const dict = t(locale);
---

<Base
  locale={locale}
  dict={dict}
  noindex
  meta={{
    title: '404 — страница не найдена | EXCLAMATION',
    description: 'Такой страницы нет. Вернитесь на главную или посмотрите кейсы.',
  }}
>
  <NotFound locale={locale} dict={dict} />
</Base>
