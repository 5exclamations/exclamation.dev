---
import Base from '../../../layouts/Base.astro';
import CaseView from '../../../components/CaseView.astro';
import { t } from '../../../i18n';

const locale = 'ru' as const;
const dict = t(locale);

export function getStaticPaths() {
  return t('ru').cases.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const item = dict.cases.find((c) => c.slug === slug)!;
// written per case in the dictionaries, not assembled from the case copy
const meta = dict.caseSeo[slug as keyof typeof dict.caseSeo];
---

<Base locale={locale} dict={dict} meta={meta} ogKey={`case-${slug}`} schemaKind="case">
  <CaseView locale={locale} dict={dict} slug={slug!} />
</Base>
