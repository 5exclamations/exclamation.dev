---
import Base from '../../../layouts/Base.astro';
import ServicePage from '../../../components/ServicePage.astro';
import { web } from '../../../i18n/services/web';
import { serviceAlternates } from '../../../data/services';
import { t } from '../../../i18n';

const locale = 'ru' as const;
const dict = t(locale);
const copy = web[locale];
---

<Base
  locale={locale}
  dict={dict}
  meta={copy.meta}
  ogKey="service-web"
  schemaKind="service"
  faq={copy.faq.items}
  alternates={serviceAlternates('web')}
>
  <ServicePage locale={locale} dict={dict} copy={copy} />
</Base>
