---
import '../styles/app.css';
import Header from '../components/Header.astro';
import SpineEnd from '../components/SpineEnd.astro';
import Footer from '../components/Footer.astro';
import { localePath, locales, localeSubset, type Locale, type Dict } from '../i18n';

interface Props {
  locale: Locale;
  dict: Dict;
  /** per-page overrides; the dictionary supplies the home page defaults */
  meta?: { title: string; description: string };
  /** error pages: keep them out of the index and off the hreflang cluster */
  noindex?: boolean;
  /**
   * Which Open Graph card to point at, without the locale suffix — `home`,
   * `page`, or `case-<slug>`. Generated by `src/pages/og/[key].png.ts`.
   */
  ogKey?: string;
}
const { locale, dict, meta, noindex = false, ogKey = 'page' } = Astro.props;
const head = meta ?? dict.meta;
const subset = localeSubset[locale];
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';

/** the locale-free path, so canonical and hreflang work on every route */
const current = (Astro.url.pathname.replace(/\/+$/, '') || '/').replace(
  /^\/(ru|en)(?=\/|$)/,
  ''
) || '/';
---

<!doctype html>
<html lang={dict.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{head.title}</title>
    <meta name="description" content={head.description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <>
        <link rel="canonical" href={`${site}${localePath(locale, current)}`} />
        {locales.map((l) => (
          <link rel="alternate" hreflang={l} href={`${site}${localePath(l, current)}`} />
        ))}
        <link rel="alternate" hreflang="x-default" href={`${site}${current}`} />
      </>
    )}

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={`/fonts/Geologica-${subset}.woff2`}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={`/fonts/Commissioner-${subset}.woff2`}
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={head.title} />
    <meta property="og:description" content={head.description} />
    <meta property="og:locale" content={locale} />
    <meta property="og:url" content={`${site}${localePath(locale, current)}`} />
    <meta property="og:image" content={`${site}/og/${ogKey}-${locale}.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={head.title} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        try {
          const stored = localStorage.getItem('exclamation-theme');
          if (stored === 'dark' || stored === 'light') {
            document.documentElement.dataset.theme = stored;
          } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.dataset.theme = 'dark';
          } else {
            document.documentElement.dataset.theme = 'light';
          }
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{dict.nav.skip}</a>

    <div class="page">
      <div class="spine-wrap" aria-hidden="true">
        <div class="shell spine-shell"><span class="spine"></span></div>
      </div>
      <Header locale={locale} dict={dict} path={current} />
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <SpineEnd />
      <Footer locale={locale} dict={dict} path={current} />
    </div>

    <script>
      const targets = document.querySelectorAll('[data-reveal]');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              (entry.target as HTMLElement).classList.add('is-in');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.05 }
        );
        targets.forEach((el) => io.observe(el));
      } else {
        targets.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>

<style>
  .page {
    position: relative;
  }
  main:focus {
    outline: none;
  }

  /* the spine draws itself once, on load, as part of the opening scene */
  .spine {
    transform-origin: top;
    animation: draw 420ms var(--ease) both;
  }
  @keyframes draw {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .spine {
      animation: none;
    }
  }
</style>
