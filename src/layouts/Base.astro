---
import '../styles/app.css';
import Header from '../components/Header.astro';
import Analytics from '../components/Analytics.astro';
import LegacyHash from '../components/LegacyHash.astro';
import Schema from '../components/Schema.astro';
import SpineEnd from '../components/SpineEnd.astro';
import Footer from '../components/Footer.astro';
import { localePath, locales, localeSubset, type Locale, type Dict } from '../i18n';

interface Props {
  locale: Locale;
  dict: Dict;
  /** per-page overrides; the dictionary supplies the home page defaults */
  meta?: { title: string; description: string };
  /** error pages: keep them out of the index and off the hreflang cluster */
  noindex?: boolean;
  /**
   * Which Open Graph card to point at, without the locale suffix — `home`,
   * `page`, or `case-<slug>`. Generated by `src/pages/og/[key].png.ts`.
   */
  ogKey?: string;
  /** which structured-data shape this route is */
  schemaKind?: 'home' | 'case' | 'service' | 'other';
  /** questions to publish as FAQPage; must match what the page renders */
  faq?: { q: string; a: string }[];
  /**
   * Explicit per-locale paths, for routes whose slug differs by language
   * (the service pages). Without this the alternates are derived by stripping
   * the locale prefix, which only works when all three share one path.
   */
  alternates?: Record<Locale, string>;
}
const {
  locale,
  dict,
  meta,
  noindex = false,
  ogKey = 'page',
  schemaKind = 'other',
  alternates,
  faq,
} = Astro.props;
const head = meta ?? dict.meta;
const subset = localeSubset[locale];

/**
 * Two preloads on every route: the locale's own subset of the two display
 * faces.
 *
 * Adding the `latin` subset as well — it is fetched on every az and ru page,
 * just discovered late — was measured and reverted: it pushed the home page
 * from 1976ms to 2120ms and did nothing for CLS. That was while the hero
 * screenshot was still there and competing for the pipe; with the image gone
 * the trade may be worth re-measuring, but the fonts are now the whole of the
 * critical path, so more preloading is unlikely to help.
 *
 * The CLS these were chasing is solved in fonts.css instead, by metric-matched
 * fallbacks, which cost no bytes and no request ordering at all.
 */
const fontPreloads = [
  `/fonts/Geologica-${subset}.woff2`,
  `/fonts/Commissioner-${subset}.woff2`,
];

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';

/** the locale-free path, so canonical and hreflang work on every route */
const current = (Astro.url.pathname.replace(/\/+$/, '') || '/').replace(
  /^\/(ru|en)(?=\/|$)/,
  ''
) || '/';

/** the canonical URL for each locale: explicit when given, derived otherwise */
const hrefFor = (l: Locale) => alternates?.[l] ?? localePath(l, current);
const selfPath = hrefFor(locale);

/**
 * No image preload any more.
 *
 * The landing page's LCP element used to be the hero screenshot, so it was
 * preloaded at high priority. The screenshot was removed from the first screen
 * on 2026-08-09 and the first screen is now typography and the diff block, so
 * there is nothing above the fold to preload — and preloading an image the
 * page never renders would be a pure waste of the connection.
 */
---

<!doctype html>
<html lang={dict.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{head.title}</title>
    <meta name="description" content={head.description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <>
        <link rel="canonical" href={`${site}${selfPath}`} />
        {locales.map((l) => (
          <link rel="alternate" hreflang={l} href={`${site}${hrefFor(l)}`} />
        ))}
        <link rel="alternate" hreflang="x-default" href={`${site}${hrefFor('az')}`} />
      </>
    )}

    {fontPreloads.map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
    ))}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={head.title} />
    <meta property="og:description" content={head.description} />
    <meta property="og:locale" content={locale} />
    <meta property="og:url" content={`${site}${selfPath}`} />
    <meta property="og:image" content={`${site}/og/${ogKey}-${locale}.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={head.title} />
    <meta name="twitter:card" content="summary_large_image" />

    {!noindex && (
      <Schema
        locale={locale}
        dict={dict}
        path={selfPath}
        kind={schemaKind}
        title={head.title}
        faq={faq}
        ogKey={ogKey}
        absolute
      />
    )}

    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        try {
          const stored = localStorage.getItem('exclamation-theme');
          if (stored === 'dark' || stored === 'light') {
            document.documentElement.dataset.theme = stored;
          } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.dataset.theme = 'dark';
          } else {
            document.documentElement.dataset.theme = 'light';
          }
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>

    {/* Only on the landing pages: `/` is the only URL the legacy site had,
        so it is the only place a legacy fragment can arrive. */}
    {schemaKind === 'home' && <LegacyHash locale={locale} />}

    {/* last in head and `defer`: analytics must never be in front of the
        fonts in the request queue */}
    <Analytics />
  </head>

  <body>
    <a class="skip-link" href="#main">{dict.nav.skip}</a>

    <div class="page">
      <div class="spine-wrap" aria-hidden="true">
        <div class="shell spine-shell"><span class="spine"></span></div>
      </div>
      <Header locale={locale} dict={dict} path={current} alternates={alternates} />
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <SpineEnd />
      <Footer locale={locale} dict={dict} path={current} alternates={alternates} />
    </div>

    <script>
      const targets = document.querySelectorAll('[data-reveal]');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              (entry.target as HTMLElement).classList.add('is-in');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.05 }
        );
        targets.forEach((el) => io.observe(el));
      } else {
        targets.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>

<style>
  .page {
    position: relative;
  }
  main:focus {
    outline: none;
  }

  /* the spine draws itself once, on load, as part of the opening scene */
  .spine {
    transform-origin: top;
    animation: draw 420ms var(--ease) both;
  }
  @keyframes draw {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .spine {
      animation: none;
    }
  }
</style>
