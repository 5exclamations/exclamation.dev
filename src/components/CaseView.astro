---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import Diff from './Diff.astro';
import CaseChat from './CaseChat.astro';
import { localePath, type Dict, type Locale } from '../i18n';
import { mediaFor } from '../data/cases';

interface Props {
  locale: Locale;
  dict: Dict;
  slug: string;
}
const { locale, dict, slug } = Astro.props;
const ui = dict.caseUi;

const all = dict.cases;
const index = all.findIndex((c) => c.slug === slug);
const item = all[index];
const next = all[(index + 1) % all.length];
const media = mediaFor(slug);
---

<article class="case">
  <header class="case-head">
    <div class="shell">
      <div class="case-head-in">
        <a class="case-back" href={`${localePath(locale)}#work`}>
          <Icon name="arrow-right" size={16} class="flip" />
          {ui.back}
        </a>

        <p class="mono case-tag">{item.tag} · {item.domain}</p>
        <h1 class="case-title">{item.title}</h1>

        <Diff rows={item.diff} startLine={1} class="case-diff" />

        <ul class="case-results">
          {item.results.map((r) => (
            <li>
              <span class="case-result-value num">{r.value}</span>
              <span class="case-result-label">{r.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </header>

  <div class="shell">
    <div class="case-body">
      <section class="case-text" aria-labelledby={`h-task-${slug}`}>
        <h2 id={`h-task-${slug}`} class="mono">{ui.task}</h2>
        <p>{item.task}</p>
      </section>
      <section class="case-text" aria-labelledby={`h-sol-${slug}`}>
        <h2 id={`h-sol-${slug}`} class="mono">{ui.solution}</h2>
        <p>{item.solution}</p>
      </section>
    </div>

    <section class="case-screens" aria-labelledby={`h-screens-${slug}`}>
      <h2 id={`h-screens-${slug}`} class="mono screens-head">{ui.screens}</h2>

      {media.shots.length ? (
        <div class:list={['gallery', `is-${media.shape}`]}>
          {media.shots.map((shot, i) => {
            const [cw, cx, cy] = shot.crop ?? media.crop;
            return (
            <figure data-reveal>
              <div class="frame">
                <Picture
                  src={shot.img}
                  alt={item.alts[i]}
                  widths={[480, 780, 1200, shot.img.width]}
                  {/* below 640 the image is not scaled to the viewport — it is
                      rendered at the crop width and slid under the frame, so
                      `sizes` has to say cw, not 100vw, or the browser picks a
                      candidate narrower than the pixels it actually paints */}
                  sizes={`(min-width: 1024px) 1100px, (min-width: 640px) 92vw, ${cw}px`}
                  formats={['avif', 'webp']}
                  fallbackFormat="webp"
                  loading="lazy"
                  decoding="async"
                  style={`--crop-w: ${cw}px; --crop-x: ${-cx}px; --crop-y: ${-cy}px`}
                />
              </div>
              <figcaption class="mono">{item.alts[i]}</figcaption>
            </figure>
            );
          })}
        </div>
      ) : (
        <figure class="mock" data-reveal>
          <div class="frame frame-mock">
            <CaseChat dict={dict} />
          </div>
          <figcaption class="mono">{ui.mockCaption}</figcaption>
        </figure>
      )}
    </section>

    <section class="case-stack" aria-labelledby={`h-stack-${slug}`}>
      <h2 id={`h-stack-${slug}`} class="mono">{ui.stack}</h2>
      <p class="stack-list">
        {item.stack.map((tech, i) => (
          <>
            {i > 0 && <span class="sep" aria-hidden="true"> · </span>}
            {tech}
          </>
        ))}
      </p>
    </section>

    <section class="case-cta" aria-labelledby={`h-cta-${slug}`}>
      <h2 id={`h-cta-${slug}`} class="case-cta-title">{ui.ctaTitle}</h2>
      <p class="case-cta-text">{ui.ctaText}</p>
      <p>
        <a class="btn" href={`${localePath(locale)}#contact`}>
          {ui.cta}
          <Icon name="arrow-right" size={18} />
        </a>
      </p>
    </section>

    <nav class="case-next" aria-label={ui.next}>
      <a href={localePath(locale, `/is/${next.slug}`)}>
        <span class="mono">{ui.next}</span>
        <span class="case-next-name">
          {next.short}
          <Icon name="arrow-right" size={20} />
        </span>
      </a>
    </nav>
  </div>
</article>

<style>
  .case {
    position: relative;
    z-index: 1;
  }

  .case-head-in {
    padding-left: var(--rail);
    padding-top: var(--sp-section);
    padding-bottom: var(--sp-section);
  }

  .case-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-size: var(--fs-200);
    color: var(--fg-muted);
    text-decoration: none;
    transition: color 140ms var(--ease);
  }
  .case-back:hover {
    color: var(--fg);
  }
  .case-back :global(.flip) {
    transform: scaleX(-1);
  }

  .case-tag {
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
  }
  .case-title {
    margin: 1rem 0 clamp(1.75rem, 4vw, 2.5rem);
    font-size: var(--fs-700);
    font-weight: 300;
    max-width: 20ch;
  }

  .case-results {
    display: grid;
    gap: var(--sp-block) clamp(1rem, 3vw, 2.5rem);
    margin-top: var(--sp-section);
    padding-top: var(--sp-block);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 640px) {
    .case-results {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    }
  }
  .case-results li {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .case-result-value {
    font-family: var(--font-display);
    font-size: var(--fs-600);
    font-weight: 300;
    line-height: 1;
  }
  .case-result-label {
    font-size: var(--fs-200);
    color: var(--fg-muted);
    max-width: 24ch;
  }

  .case-body {
    display: grid;
    gap: var(--sp-block) clamp(2rem, 5vw, 4rem);
    padding-left: var(--rail);
    padding-block: var(--sp-chapter);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .case-body {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .case-text h2 {
    padding-bottom: 0.75rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .case-text p {
    max-width: 56ch;
    line-height: 1.62;
  }

  .case-screens {
    padding-left: var(--rail);
    padding-bottom: var(--sp-chapter);
  }
  .screens-head {
    padding-bottom: 0.75rem;
    margin-bottom: var(--sp-block);
    border-bottom: 1px solid var(--line);
  }

  .gallery {
    display: grid;
    gap: var(--sp-section);
  }
  .gallery.is-phone {
    gap: var(--sp-block);
  }
  @media (min-width: 640px) {
    .gallery.is-phone {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .frame {
    position: relative;
    overflow: hidden;
    background: var(--bg-raised);
    border: 1px solid var(--line);
  }
  .frame-mock {
    min-height: 22rem;
  }

  /* narrow screens: a legible 1:1 slice of the real screen, per the system.
     From 640 up the whole screen is shown at its own ratio. */
  .is-desktop .frame {
    aspect-ratio: 4 / 3;
  }
  .is-desktop .frame img {
    position: absolute;
    width: var(--crop-w);
    max-width: none;
    height: auto;
    left: var(--crop-x);
    top: var(--crop-y);
  }
  @media (min-width: 640px) {
    .is-desktop .frame {
      aspect-ratio: auto;
    }
    .is-desktop .frame img {
      position: static;
      width: 100%;
      height: auto;
    }
  }
  .is-phone .frame img {
    width: 100%;
    height: auto;
  }

  figcaption {
    padding-top: 0.75rem;
    text-transform: none;
    letter-spacing: 0.02em;
    max-width: 64ch;
  }

  .case-stack {
    padding-left: var(--rail);
    padding-block: var(--sp-section);
    border-top: 1px solid var(--line);
  }
  .case-stack h2 {
    margin-bottom: 0.75rem;
  }
  .stack-list {
    font-family: var(--font-display);
    font-size: var(--fs-400);
    font-weight: 300;
  }
  .stack-list .sep {
    color: var(--fg-muted);
  }

  .case-cta {
    padding-left: var(--rail);
    padding-block: var(--sp-chapter);
    border-top: 1px solid var(--line);
  }
  .case-cta-title {
    font-size: var(--fs-600);
    font-weight: 300;
    max-width: 18ch;
  }
  .case-cta-text {
    margin: 1rem 0 var(--sp-block);
    color: var(--fg-muted);
    max-width: 46ch;
  }

  .case-next {
    padding-left: var(--rail);
    padding-block: var(--sp-section);
    border-top: 1px solid var(--line);
  }
  .case-next a {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-decoration: none;
    color: inherit;
  }
  .case-next-name {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: var(--fs-500);
    font-weight: 300;
    letter-spacing: -0.02em;
    transition: color 140ms var(--ease);
  }
  .case-next a:hover .case-next-name {
    color: var(--accent);
  }
</style>
