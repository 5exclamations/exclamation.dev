---
import Icon from './Icon.astro';
import { localePath, type Dict, type Locale } from '../i18n';

/**
 * What is left of "why it pays": two lines and a link.
 *
 * It was a full chapter — three paragraphs, a heading and three measured bars.
 * The bars showed +45%, −70% and −80%, which are the same three figures the
 * case grid prints under CRM Portal and FLEKS a screen later, so the section
 * argued its case with numbers the reader was about to meet again. The
 * argument itself belongs on the service pages, where each one makes it with
 * that service's own figures rather than in general.
 *
 * `id="why"` is load-bearing: LegacyHash.astro maps the old `#advantages`,
 * `#trust` and `#who` fragments onto it.
 */
interface Props {
  locale: Locale;
  dict: Dict;
}
const { locale, dict } = Astro.props;
const w = dict.why;
---

<section class="why" id="why" aria-labelledby="why-title">
  <div class="shell">
    <div class="why-inner">
      <h2 class="mono why-eyebrow" id="why-title" data-reveal>{w.eyebrow}</h2>
      {w.lines.map((line) => (
        <p class="why-line" data-reveal>{line}</p>
      ))}
      <p data-reveal>
        <a class="why-link" href={`${localePath(locale, '/')}#services`}>
          {w.link}
          <Icon name="arrow-right" size={16} />
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  /* A short measure hung off the rail, between the dense services grid above
     and the full-bleed case images below — deliberately the thinnest thing on
     the page rather than a third variation on a heading-plus-body block. */
  .why {
    position: relative;
    z-index: 1;
    padding-block: var(--sp-chapter);
  }
  .why-inner {
    padding-left: var(--rail);
    max-width: 52ch;
  }
  .why-eyebrow {
    margin-bottom: var(--sp-block);
    font-weight: 400;
  }
  .why-line {
    font-size: var(--fs-400);
    line-height: 1.55;
  }
  .why-line + .why-line {
    margin-top: 0.9em;
  }

  /* the same underline the case names use, so a text link reads the same way
     everywhere on the page */
  .why-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 2.75rem;
    margin-top: var(--sp-block);
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.22em;
    transition: color 140ms var(--ease), text-decoration-color 140ms var(--ease);
  }
  .why-link:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
</style>
