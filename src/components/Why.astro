---
import type { Dict } from '../i18n';

interface Props {
  dict: Dict;
}
const { dict } = Astro.props;
const w = dict.why;

/** `**text**` in the copy becomes an emphasised span. No markdown runtime. */
const parts = (line: string) =>
  line.split('**').map((chunk, i) => ({ text: chunk, mark: i % 2 === 1 }));
---

<section class="why" id="why" aria-labelledby="why-title">
  <div class="shell">
    <div class="why-inner">
      <p class="mono" data-reveal>{w.eyebrow}</p>

      <h2 id="why-title" class="why-title" data-reveal>
        <span class="muted">{w.titleMuted}</span> {w.titleMain}
      </h2>

      <div class="why-prose">
        {w.paras.map((p) => (
          <p data-reveal>
            {parts(p).map((chunk) => (chunk.mark ? <mark>{chunk.text}</mark> : chunk.text))}
          </p>
        ))}
      </div>

      <div class="why-bars" data-reveal>
        <p class="mono why-bars-title">{w.barsTitle}</p>
        <dl>
          {w.bars.map((bar) => (
            <div class="bar">
              <dt>{bar.label}</dt>
              <dd>
                <span class="bar-track" aria-hidden="true">
                  <span class="bar-fill" style={`--pct: ${bar.pct}%`}></span>
                </span>
                <span class="bar-value num">{bar.value}</span>
                <span class="bar-source mono">{bar.source}</span>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .why {
    position: relative;
    z-index: 1;
    padding-block: var(--sp-chapter);
  }

  /* seven columns, pushed off the spine — deliberately not the services grid */
  .why-inner {
    padding-left: var(--rail);
  }
  @media (min-width: 1024px) {
    .why-inner {
      width: 62%;
      margin-left: 16.6667%;
      padding-left: 0;
    }
  }

  .why-title {
    font-size: var(--fs-600);
    font-weight: 300;
    margin: clamp(1.25rem, 3vw, 2rem) 0 clamp(2rem, 4vw, 3rem);
    max-width: 22ch;
  }
  .why-title .muted {
    color: var(--fg-muted);
  }

  .why-prose p {
    font-size: var(--fs-400);
    line-height: 1.62;
    max-width: 58ch;
  }
  .why-prose p + p {
    margin-top: 1.25em;
  }
  .why-prose mark {
    background: var(--accent-wash);
    color: inherit;
    padding: 0.05em 0.2em;
    margin: 0 -0.05em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .why-bars {
    margin-top: var(--sp-section);
    max-width: 42rem;
  }
  .why-bars-title {
    padding-bottom: 0.875rem;
    border-bottom: 1px solid var(--line);
  }
  .why-bars dl {
    margin: 0;
  }
  .bar {
    padding-block: clamp(1rem, 2vw, 1.375rem);
    border-bottom: 1px solid var(--line);
  }
  .bar dt {
    font-size: var(--fs-200);
    color: var(--fg-muted);
    margin-bottom: 0.625rem;
  }
  .bar dd {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 1rem;
    row-gap: 0.375rem;
    margin: 0;
  }
  .bar-track {
    display: block;
    height: 8px;
    background: var(--line);
  }
  .bar-fill {
    display: block;
    height: 100%;
    width: var(--pct);
    background: var(--fg);
  }
  .bar-value {
    font-family: var(--font-display);
    font-size: var(--fs-500);
    font-weight: 400;
    line-height: 1;
    text-align: right;
  }
  .bar-source {
    grid-column: 1;
    color: var(--fg-muted);
    text-transform: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .bar-fill {
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 240ms var(--ease) 60ms;
    }
    :global(.js) [data-reveal].is-in .bar-fill {
      transform: none;
    }
  }
</style>
