---
import Icon from './Icon.astro';
import type { Dict } from '../i18n';

interface Props {
  dict: Dict;
}
const { dict } = Astro.props;
const fc = dict.finalcta;
---

{/*
  The landing page's closing call. The terminating dot is not here — it lives
  in SpineEnd, above the footer, so the exclamation mark closes the same way
  on every route rather than only on this one.

  No eyebrow here on purpose: every other section is introduced by one, and
  this block is the last word rather than another chapter.
*/}
<section class="finalcta" aria-labelledby="finalcta-title">
  <div class="shell">
    <div class="finalcta-body">
      <h2 id="finalcta-title" data-reveal>
        <span class="muted">{fc.titleMuted}</span> {fc.titleMain}
      </h2>
      <p class="finalcta-note" data-reveal>{fc.note}</p>
      <p data-reveal>
        {/* the same words the first screen used: the page opens and closes
            on one call, rather than inventing a second name for the form */}
        <a class="btn" href="#contact">
          {dict.hero.cta}
          <Icon name="arrow-right" size={17} />
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  .finalcta {
    position: relative;
    z-index: 1;
    padding-block: var(--sp-major) var(--sp-chapter);
  }

  .finalcta-body {
    padding-left: var(--rail);
  }

  .finalcta h2 {
    font-size: var(--fs-700);
    font-weight: 300;
    max-width: 16ch;
  }
  .finalcta h2 .muted {
    color: var(--fg-muted);
  }

  .finalcta-note {
    margin-top: 1.5rem;
    margin-bottom: var(--sp-block);
    color: var(--fg-muted);
    max-width: 42ch;
  }
</style>
