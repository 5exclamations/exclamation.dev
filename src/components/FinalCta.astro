---
import Icon from './Icon.astro';
import type { Dict } from '../i18n';

interface Props {
  dict: Dict;
}
const { dict } = Astro.props;
const fc = dict.finalcta;
---

{/*
  The payoff of the signature. The spine has drawn a 1px stroke down the whole
  page; this section's opaque ground cuts it off, leaves a gap, and sets the
  square beneath it. Stroke, gap, dot — the page is one exclamation mark.

  No eyebrow here on purpose: every other section is introduced by one, and
  this block is punctuation rather than another chapter.
*/}
<section class="finalcta" aria-labelledby="finalcta-title">
  <div class="shell">
    <div class="finalcta-row">
      <span class="dot" aria-hidden="true"></span>
      <div class="finalcta-body">
      <h2 id="finalcta-title" data-reveal>
        <span class="muted">{fc.titleMuted}</span> {fc.titleMain}
      </h2>
      <p class="finalcta-note" data-reveal>{fc.note}</p>
      <p data-reveal>
        {/* the same words the first screen used: the page opens and closes
            on one call, rather than inventing a second name for the form */}
        <a class="btn" href="#contact">
          {dict.hero.cta}
          <Icon name="arrow-right" size={17} />
          </a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* opaque: this is what stops the spine. Everything below the top edge of
     this section is beneath the dot, so the stroke must not reach it. */
  /* the gap of the exclamation mark is this padding: the stroke stops at the
     top edge, the dot is the first thing below it */
  .finalcta {
    position: relative;
    z-index: 1;
    background: var(--bg);
    padding-block: var(--sp-major);
  }

  /* below 768 there is no rail and no spine, so the dot simply leads the
     block; from 768 it takes the rail column and lands on the stroke's axis */
  .finalcta-row {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .finalcta-row {
      grid-template-columns: var(--rail) minmax(0, 1fr);
      align-items: start;
      gap: 0;
    }
    .dot {
      justify-self: center;
      /* the stroke is 1px wide starting at rail/2, so its centre is half a
         pixel to the right of the column's centre */
      transform: translateX(0.5px);
    }
  }

  .dot {
    width: 1rem;
    height: 1rem;
    background: var(--accent-flat);
    /* em against the headline size, so the square keeps sitting on the cap
       line of the first line at every viewport */
    font-size: var(--fs-700);
    margin-top: 0.3em;
  }

  .finalcta h2 {
    font-size: var(--fs-700);
    font-weight: 300;
    max-width: 16ch;
  }
  .finalcta h2 .muted {
    color: var(--fg-muted);
  }

  .finalcta-note {
    margin-top: 1.5rem;
    margin-bottom: var(--sp-block);
    color: var(--fg-muted);
    max-width: 42ch;
  }
</style>
