---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import Diff from './Diff.astro';
import { heroShot } from '../data/cases';
import { fill, type Dict } from '../i18n';

interface Props {
  dict: Dict;
}
const { dict } = Astro.props;
const hero = dict.hero;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="shell">
    <div class="hero-inner">
      <p class="mono hero-eyebrow anim" style="--d: 100ms">{fill(hero.eyebrow)}</p>

      <h1 class="hero-title" id="hero-title">
        <span class="line"><span class="line-in anim-lift muted" style="--d: 140ms">{hero.titleMuted}</span></span>
        <span class="line"><span class="line-in anim-lift" style="--d: 210ms">{hero.titleMain}</span></span>
      </h1>

      <div class="hero-cols">
        <p class="hero-sub anim" style="--d: 320ms">{hero.sub}</p>

        <div class="hero-diff"><Diff rows={hero.diff} delays={[360, 400]} /></div>

        <p class="hero-cta anim" style="--d: 440ms">
          <a class="btn" href="#contact">
            {hero.cta}
            <Icon name="arrow-right" size={18} />
          </a>
        </p>
      </div>
    </div>
  </div>

  <div class="shell">
    <figure class="hero-shot anim" style="--d: 460ms">
      <div class="hero-shot-frame">
        {/* the one image above the fold: eager, high priority, and the only
            place on the site that does not lazy-load */}
        <Picture
          src={heroShot}
          alt={hero.shotAlt}
          widths={[640, 960, 1280, 1600]}
          {/* 780px below 640: the narrow view is a detail crop at fixed width,
              not the whole screen scaled down */}
          sizes="(min-width: 1240px) 1160px, (min-width: 640px) 92vw, 780px"
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <figcaption class="mono">{hero.shotCaption}</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 1;
  }

  .hero-inner {
    padding-left: var(--rail);
    padding-top: clamp(2.5rem, 7vh, 5.5rem);
    padding-bottom: clamp(2.5rem, 6vh, 4.5rem);
  }

  .hero-eyebrow {
    margin-bottom: clamp(1.5rem, 4vh, 2.5rem);
  }

  .hero-title {
    font-size: var(--fs-800);
    font-weight: 700;
    letter-spacing: -0.045em;
    margin-bottom: clamp(1.25rem, 3vh, 2rem);
  }
  .hero-title .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .hero-title .line-in {
    display: block;
  }
  .hero-title .muted {
    color: var(--fg-muted);
  }

  .hero-cols {
    display: grid;
    gap: clamp(1.75rem, 4vh, 2.5rem) clamp(1.5rem, 4vw, 3rem);
  }
  @media (min-width: 1024px) {
    .hero-cols {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: start;
    }
    .hero-sub {
      grid-column: 1;
      grid-row: 1;
    }
    .hero-cta {
      grid-column: 1;
      grid-row: 2;
      align-self: start;
    }
    .hero-diff {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }

  .hero-sub {
    font-size: var(--fs-400);
    line-height: 1.5;
    color: var(--fg-muted);
    max-width: 42ch;
  }

  .hero-shot {
    margin-left: var(--rail);
    margin-top: clamp(1.75rem, 5vh, 4rem);
    margin-bottom: var(--sp-section);
  }
  .hero-shot-frame {
    position: relative;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    overflow: hidden;
    /* narrow screens get a detail crop of the real screen instead of a
       full desktop UI shrunk down to an illegible thumbnail */
    aspect-ratio: 4 / 3;
  }
  .hero-shot img {
    position: absolute;
    width: 780px;
    max-width: none;
    height: auto;
    left: -155px;
    top: -95px;
  }
  .hero-shot figcaption {
    padding-top: 0.75rem;
    text-transform: none;
    letter-spacing: 0.02em;
  }
  @media (min-width: 640px) {
    .hero-shot-frame {
      aspect-ratio: 16 / 10;
    }
    .hero-shot img {
      position: static;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
    }
  }
  @media (min-width: 1024px) {
    .hero-shot-frame {
      aspect-ratio: 16 / 9;
    }
  }

</style>
