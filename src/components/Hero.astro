---
import Icon from './Icon.astro';
import Diff from './Diff.astro';
import { fill, type Dict } from '../i18n';

/**
 * The first screen carries typography and the diff block, and no image.
 *
 * It used to end with a full-width CRM Portal screenshot. It was dropped
 * 2026-08-09: the same screenshot leads the `work` section a screen later,
 * and at the top it filled the viewport while explaining nothing — a reader
 * who has not been told what CRM Portal is cannot get anything from a
 * screenshot of it. The diff block is what states the change on offer.
 */

interface Props {
  dict: Dict;
}
const { dict } = Astro.props;
const hero = dict.hero;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="shell">
    <div class="hero-inner">
      <p class="mono hero-eyebrow anim" style="--d: 100ms">{fill(hero.eyebrow)}</p>

      <h1 class="hero-title" id="hero-title">
        <span class="line"><span class="line-in anim-lift muted" style="--d: 140ms">{hero.titleMuted}</span></span>
        <span class="line"><span class="line-in anim-lift" style="--d: 210ms">{hero.titleMain}</span></span>
      </h1>

      <div class="hero-cols">
        <p class="hero-sub anim" style="--d: 320ms">{hero.sub}</p>

        <div class="hero-diff"><Diff rows={hero.diff} delays={[360, 400]} /></div>

        <p class="hero-cta anim" style="--d: 440ms">
          <a class="btn" href="#contact">
            {hero.cta}
            <Icon name="arrow-right" size={18} />
          </a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 1;
  }

  .hero-inner {
    padding-left: var(--rail);
    padding-top: clamp(2.5rem, 7vh, 5.5rem);
    /* the screen used to end on the figure, which carried the gap down to
       the services section; with it gone the CTA is last and this does */
    padding-bottom: var(--sp-chapter);
  }

  .hero-eyebrow {
    margin-bottom: clamp(1.5rem, 4vh, 2.5rem);
  }

  .hero-title {
    font-size: var(--fs-800);
    font-weight: 700;
    letter-spacing: -0.045em;
    margin-bottom: clamp(1.25rem, 3vh, 2rem);
  }
  .hero-title .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .hero-title .line-in {
    display: block;
  }
  .hero-title .muted {
    color: var(--fg-muted);
  }

  .hero-cols {
    display: grid;
    gap: clamp(1.75rem, 4vh, 2.5rem) clamp(1.5rem, 4vw, 3rem);
  }
  @media (min-width: 1024px) {
    .hero-cols {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: start;
    }
    .hero-sub {
      grid-column: 1;
      grid-row: 1;
    }
    .hero-cta {
      grid-column: 1;
      grid-row: 2;
      align-self: start;
    }
    .hero-diff {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }

  .hero-sub {
    font-size: var(--fs-400);
    line-height: 1.5;
    color: var(--fg-muted);
    max-width: 42ch;
  }

</style>
