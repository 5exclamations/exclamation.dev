---
import Icon from './Icon.astro';
import { faqPage, faqCount } from '../i18n/faq';
import { localePath, type Dict, type Locale } from '../i18n';

/**
 * Four questions on the landing page, and a link to the thirty on /faq/.
 *
 * It carried eight until 2026-08-09. The count in the link is read off the
 * FAQ page's own data rather than typed, so adding a question there cannot
 * leave this sentence claiming the old number.
 */
interface Props {
  locale: Locale;
  dict: Dict;
}
const { locale, dict } = Astro.props;
const f = dict.faq;
const more = f.more.replace('{count}', String(faqCount(faqPage[locale])));
---

<section class="faq" id="faq" aria-labelledby="faq-title">
  <div class="shell">
    <header class="faq-head">
      <p class="mono">{f.eyebrow}</p>
      <h2 id="faq-title" data-reveal>
        <span class="muted">{f.titleMuted}</span> {f.titleMain}
      </h2>
    </header>

    {/* native <details>: the disclosure semantics, keyboard handling and
        find-in-page expansion come from the platform, and every answer is
        readable with JS off */}
    <div class="faq-list">
      {f.items.map((item) => (
        <details class="faq-item" name="faq" data-reveal>
          <summary>
            <span class="faq-q">{item.q}</span>
            <Icon name="plus" size={20} class="faq-mark" />
          </summary>
          <div class="faq-a">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>

    <p class="faq-more" data-reveal>
      <a href={localePath(locale, '/faq')}>
        {more}
        <Icon name="arrow-right" size={16} />
      </a>
    </p>
  </div>
</section>

<style>
  /* single column, one question per hairline row — deliberately not the
     three staggered blocks above it */
  .faq {
    position: relative;
    z-index: 1;
    padding-block: var(--sp-chapter);
    border-top: 1px solid var(--line);
  }

  .faq-head {
    padding-left: var(--rail);
    margin-bottom: var(--sp-section);
  }
  .faq-head h2 {
    margin-top: 1rem;
    font-size: var(--fs-600);
    font-weight: 300;
    max-width: 18ch;
  }
  .faq-head h2 .muted {
    color: var(--fg-muted);
  }

  .faq-list {
    padding-left: var(--rail);
    max-width: 54rem;
  }

  .faq-item {
    border-top: 1px solid var(--line);
  }
  .faq-item:last-child {
    border-bottom: 1px solid var(--line);
  }

  summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    /* 44px minimum tap height comes from the padding plus the line box */
    padding-block: clamp(1rem, 2.2vw, 1.375rem);
    cursor: pointer;
    list-style: none;
    transition: color 140ms var(--ease);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:focus-visible {
    outline-offset: -2px;
  }

  .faq-q {
    font-family: var(--font-display);
    font-size: var(--fs-400);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .faq-mark {
    flex: none;
    margin-top: 0.15em;
    color: var(--fg-muted);
    transition: transform 180ms var(--ease), color 140ms var(--ease);
  }
  .faq-item[open] .faq-mark {
    transform: rotate(45deg);
    color: var(--fg);
  }

  .faq-a {
    padding-bottom: clamp(1rem, 2.2vw, 1.5rem);
    padding-right: 2.75rem;
  }
  .faq-a p {
    color: var(--fg-muted);
    max-width: 62ch;
  }

  /* the same underlined-text-plus-arrow as the case names and the why link */
  .faq-more {
    padding-left: var(--rail);
    max-width: 54rem;
    margin-top: var(--sp-block);
  }
  .faq-more a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 2.75rem;
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.22em;
    transition: color 140ms var(--ease), text-decoration-color 140ms var(--ease);
  }
  .faq-more a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  @media (hover: hover) {
    summary:hover .faq-mark {
      color: var(--accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-mark {
      transition: none;
    }
  }
</style>
