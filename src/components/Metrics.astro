---
import { fill, type Dict } from '../i18n';

interface Props {
  dict: Dict;
}
const { dict } = Astro.props;
const m = dict.metrics;
---

<section class="metrics" aria-label={m.label}>
  <div class="shell">
    <ul class="metrics-row">
      {m.items.map((item) => (
        <li data-reveal>
          <span class="metric-value num">{fill(item.value)}</span>
          <span class="metric-label">{item.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* the one pause on the page: a full-width band, nothing else in it */
  .metrics {
    position: relative;
    z-index: 1;
    padding-block: var(--sp-chapter);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .metrics-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-block) clamp(1rem, 3vw, 2.5rem);
  }
  @media (min-width: 900px) {
    .metrics-row {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      text-align: center;
    }
  }

  .metrics-row li {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  @media (min-width: 900px) {
    .metrics-row li {
      align-items: center;
    }
  }

  .metric-value {
    font-family: var(--font-display);
    font-size: var(--fs-700);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .metric-label {
    font-size: var(--fs-200);
    color: var(--fg-muted);
    max-width: 18ch;
  }
</style>
