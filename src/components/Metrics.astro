---
import { fill, type Dict } from '../i18n';

/**
 * The band of figures, now carrying the three facts that used to be their own
 * section further down the page.
 *
 * Two tiers, not one list: the three headline figures stay exactly as they
 * were — projects, years, languages, the three the client settled on — and the
 * facts sit under a hairline as a second, quieter row. Merging them into one
 * row would have made six figures of equal weight and broken that decision.
 *
 * `Facts.astro` was deleted with this change; `dict.facts.items` is still the
 * source of the second row.
 */
interface Props {
  dict: Dict;
}
const { dict } = Astro.props;
const m = dict.metrics;
const facts = dict.facts.items;
---

<section class="metrics" id="facts" aria-label={m.label}>
  <div class="shell">
    <ul class="metrics-row">
      {m.items.map((item) => (
        <li data-reveal>
          <span class="metric-value num">{fill(item.value)}</span>
          <span class="metric-label">{item.label}</span>
        </li>
      ))}
    </ul>

    <dl class="facts-row">
      {facts.map((item) => (
        <div class="fact" data-reveal>
          <dt class="mono fact-label">{item.label}</dt>
          <dd>
            <p class="fact-claim">
              <span class="fact-value num">{item.value}</span>
              <span class="fact-rest">{item.rest}</span>
            </p>
            <p class="fact-text">{item.text}</p>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  /* the one pause on the page: a full-width band, nothing else in it */
  .metrics {
    position: relative;
    z-index: 1;
    padding-block: var(--sp-chapter);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  /* Both tiers share one grid so the band reads as a single block: the same
     three tracks, the same column gap, the same left edge on the rail, and
     left-aligned throughout.

     The figures used to centre from 900px up. That was right while they were
     the only thing in the band; with the facts underneath it put two
     alignments inside one bordered block and the tiers stopped belonging to
     each other. The breakpoint at which the tracks form is shared too —
     768px, set by the facts, because three columns of running text need the
     room and three columns that appear at different widths are not one grid.

     three figures, not four: the technologies count left the band because it
     landed next to "40+ projects" and two adjacent forties read as an error.
     The number still appears, counted from the data, in the stack section. */
  .metrics-row,
  .facts-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: clamp(1.5rem, 4vw, 3.5rem);
    /* margin, not padding: the facts row carries the hairline that divides
       the two tiers, and with padding that rule would start a rail-width to
       the left of the columns it belongs to. Same reason as .footer-base. */
    margin-left: var(--rail);
  }
  @media (min-width: 768px) {
    .metrics-row,
    .facts-row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .metrics-row {
    row-gap: var(--sp-block);
  }
  .metrics-row li {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .metric-value {
    font-family: var(--font-display);
    font-size: var(--fs-700);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .metric-label {
    font-size: var(--fs-200);
    color: var(--fg-muted);
    max-width: 18ch;
  }

  /* ---- the facts, folded in under a hairline ----
     Grid, gap, left edge and breakpoint all come from the shared rule above;
     only the separation from the tier over it belongs here. The hairline is
     what keeps these two tiers rather than six items of equal weight. */
  .facts-row {
    row-gap: var(--sp-block);
    margin-top: var(--sp-section);
    padding-top: var(--sp-block);
    border-top: 1px solid var(--line);
  }
  .facts-row dd {
    margin: 0;
  }
  .fact-label {
    color: var(--fg-muted);
    margin-bottom: 0.625rem;
  }
  .fact-claim {
    font-family: var(--font-display);
    font-size: var(--fs-500);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 0.625rem;
  }
  .fact-rest {
    color: var(--fg-muted);
  }
  .fact-text {
    font-size: var(--fs-200);
    line-height: 1.55;
    color: var(--fg-muted);
    max-width: 40ch;
  }
</style>
