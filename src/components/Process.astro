---
import type { Dict } from '../i18n';

interface Props {
  dict: Dict;
}
const { dict } = Astro.props;
const p = dict.process;
---

<section class="process" id="process" aria-labelledby="process-title">
  <div class="shell">
    <header class="process-head">
      <p class="mono">{p.eyebrow}</p>
      <h2 id="process-title" data-reveal>
        <span class="muted">{p.titleMuted}</span> {p.titleMain}
      </h2>
      <p class="process-note" data-reveal>{p.note}</p>
    </header>

    <ol class="steps">
      {p.steps.map((step, i) => (
        <li class="step" data-reveal>
          <span class="step-num mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="step-body">
            <h3 class="step-title">{step.title}</h3>
            <p class="step-text">{step.text}</p>
          </div>
          <span class="step-time mono num">{step.time}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process {
    position: relative;
    z-index: 1;
    padding-block: var(--sp-chapter);
  }

  .process-head {
    padding-left: var(--rail);
    margin-bottom: var(--sp-section);
    max-width: 46rem;
  }
  .process-head h2 {
    margin-top: 1rem;
    font-size: var(--fs-600);
    font-weight: 300;
  }
  .process-head h2 .muted {
    color: var(--fg-muted);
  }
  .process-note {
    margin-top: 1rem;
    color: var(--fg-muted);
    max-width: 52ch;
  }

  /* the steps hang off the spine: number in the rail, rule to the right */
  .steps {
    padding-left: var(--rail);
  }
  .step {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    column-gap: 0.75rem;
    row-gap: 0.5rem;
    padding-block: clamp(1.25rem, 3vw, 2rem);
    border-top: 1px solid var(--line);
  }
  .step:last-child {
    border-bottom: 1px solid var(--line);
  }
  .step-num {
    color: var(--fg-muted);
    grid-area: 1 / 1;
  }
  .step-body {
    grid-area: 1 / 2;
  }
  .step-title {
    font-size: var(--fs-500);
    font-weight: 300;
    letter-spacing: -0.02em;
  }
  .step-text {
    margin-top: 0.5rem;
    color: var(--fg-muted);
    font-size: var(--fs-200);
    line-height: 1.55;
    max-width: 60ch;
  }
  .step-time {
    grid-area: 2 / 2;
    text-transform: none;
    letter-spacing: 0.04em;
    color: var(--fg);
  }

  @media (min-width: 900px) {
    .step {
      grid-template-columns: 2.5rem minmax(0, 1fr) minmax(0, 11rem);
      column-gap: clamp(1rem, 2vw, 2rem);
      align-items: baseline;
    }
    .step-time {
      grid-area: 1 / 3;
      text-align: right;
    }
  }
</style>
