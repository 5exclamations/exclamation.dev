---
import BriefForm from './BriefForm.astro';
import { channels } from '../data/contacts';
import type { Dict } from '../i18n';

interface Props {
  dict: Dict;
}
const { dict } = Astro.props;
const c = dict.contact;
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="shell">
    <div class="contact-grid">
      <div class="contact-aside">
        <p class="mono">{c.eyebrow}</p>
        <h2 id="contact-title" data-reveal>
          <span class="muted">{c.titleMuted}</span> {c.titleMain}
        </h2>
        <p class="contact-note" data-reveal>{c.note}</p>

        <h3 class="mono contact-channels-label">{c.channelsLabel}</h3>
        <ul class="contact-channels">
          {channels.map((ch) => (
            <li>
              <a
                href={ch.href}
                {...(ch.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                <span class="channel-label">{c.channels[ch.key]}</span>
                <span class="channel-value num">{ch.value}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="contact-form-col">
        <BriefForm copy={c.form} formId="brief" />
      </div>
    </div>
  </div>
</section>

<style>
  /* 5 + 7: the pitch on the left, the form on the right. Not the services
     grid — nothing here is sticky and the right column is a single block. */
  .contact {
    position: relative;
    z-index: 1;
    padding-block: var(--sp-chapter);
    border-top: 1px solid var(--line);
  }

  .contact-grid {
    padding-left: var(--rail);
    display: grid;
    gap: var(--sp-section) clamp(1.5rem, 4vw, 3.5rem);
  }
  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }

  .contact-aside h2 {
    margin-top: 1rem;
    font-size: var(--fs-600);
    font-weight: 300;
    max-width: 16ch;
  }
  .contact-aside h2 .muted {
    color: var(--fg-muted);
  }
  .contact-note {
    margin-top: 1.25rem;
    color: var(--fg-muted);
    max-width: 38ch;
  }

  .contact-channels-label {
    margin-top: var(--sp-block);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
  }
  .contact-channels a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    min-height: 3rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: color 140ms var(--ease), border-color 140ms var(--ease);
  }
  .channel-label {
    font-size: var(--fs-200);
    color: var(--fg-muted);
  }
  .channel-value {
    font-family: var(--font-mono);
    font-size: var(--fs-200);
  }
  @media (hover: hover) {
    .contact-channels a:hover {
      color: var(--accent);
      border-color: var(--accent);
    }
  }

</style>
