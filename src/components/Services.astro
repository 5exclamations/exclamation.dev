---
import Icon from './Icon.astro';
import type { Dict } from '../i18n';

interface Props {
  dict: Dict;
}
const { dict } = Astro.props;
const s = dict.services;
---

<section class="services" id="services" aria-labelledby="services-title">
  <div class="shell">
    <div class="services-grid">
      <div class="services-aside">
        <div class="services-aside-in">
          <p class="mono">{s.eyebrow}</p>
          <h2 id="services-title" data-reveal>
            <span class="muted">{s.titleMuted}</span> {s.titleMain}
          </h2>
          <p class="services-note" data-reveal>{s.note}</p>
          <p data-reveal>
            <a class="btn-quiet" href="#contact">
              {s.cta}
              <Icon name="arrow-right" size={17} />
            </a>
          </p>
        </div>
      </div>

      <ol class="services-list">
        {s.items.map((cat, i) => (
          <li class="service-row" data-reveal>
            <span class="service-num mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="service-title">{cat.title}</h3>
            <p class="service-items">
              {cat.items.map((item, j) => (
                <>
                  {j > 0 && <span class="sep" aria-hidden="true"> · </span>}
                  {item}
                </>
              ))}
            </p>
            <span class="service-count mono" aria-hidden="true">{cat.items.length}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .services {
    position: relative;
    z-index: 1;
    padding-block: var(--sp-chapter);
    border-top: 1px solid var(--line);
  }

  .services-grid {
    display: grid;
    gap: var(--sp-section) clamp(1.5rem, 4vw, 3.5rem);
    padding-left: var(--rail);
  }
  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: 0 clamp(2rem, 5vw, 5rem);
    }
  }

  .services-aside-in {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }
  @media (min-width: 1024px) {
    .services-aside-in {
      position: sticky;
      top: 7rem;
    }
  }

  .services-aside h2 {
    font-size: var(--fs-600);
    font-weight: 300;
  }
  .services-aside h2 .muted {
    color: var(--fg-muted);
  }
  .services-note {
    color: var(--fg-muted);
    max-width: 34ch;
  }

  .services-list {
    display: flex;
    flex-direction: column;
  }

  .service-row {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) 1.5rem;
    align-items: baseline;
    column-gap: 0.75rem;
    row-gap: 0.375rem;
    padding-block: clamp(1.125rem, 2.4vw, 1.625rem);
    border-top: 1px solid var(--line);
    transition: border-color 140ms var(--ease);
  }
  .service-row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .service-num {
    color: var(--fg-muted);
    grid-area: 1 / 1;
  }
  .service-title {
    grid-area: 1 / 2;
    font-size: var(--fs-500);
    font-weight: 300;
    letter-spacing: -0.02em;
  }
  .service-count {
    grid-area: 1 / 3;
    text-align: right;
    color: var(--fg-muted);
  }
  .service-items {
    grid-area: 2 / 2 / 3 / -1;
    color: var(--fg-muted);
    font-size: var(--fs-200);
    line-height: 1.55;
    max-width: 62ch;
  }
  .service-items .sep {
    /* a delimiter, but still ink on the page: keep it at text contrast */
    color: inherit;
  }

  /* the three-column row only earns its keep once the item list has real
     width; below 1200 it squeezes into a rag, so rows stay stacked */
  @media (min-width: 1200px) {
    .service-row {
      grid-template-columns: 2.5rem minmax(0, 15rem) minmax(0, 1fr) 1.5rem;
      column-gap: clamp(1rem, 2vw, 2rem);
    }
    .service-title {
      grid-area: 1 / 2;
    }
    .service-items {
      grid-area: 1 / 3;
      max-width: none;
    }
    .service-count {
      grid-area: 1 / 4;
    }
  }

  /* honest hover: the row warms up, nothing is hidden behind it */
  @media (hover: hover) {
    .service-row:hover {
      border-top-color: var(--fg);
    }
    .service-row:hover .service-items {
      color: var(--fg);
    }
  }
</style>
