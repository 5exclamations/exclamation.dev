---
import { localePath, type Dict, type Locale } from '../i18n';
import { channels, EMAIL } from '../data/contacts';
import { serviceCopy } from '../i18n/services';
import {
  ORG_NAME,
  ORG_ALTERNATE_NAMES,
  ORG_ID,
  SERVICE_ID,
  SAME_AS,
  ADDRESS,
  GEO,
} from '../data/org';

interface Props {
  locale: Locale;
  dict: Dict;
  /** page path; locale-free unless `absolute` is set */
  path: string;
  /** true when `path` is already the full per-locale path */
  absolute?: boolean;
  kind: 'home' | 'case' | 'service' | 'guide' | 'other';
  /**
   * Questions to publish as FAQPage. Passed in rather than read from the
   * dictionary, because service pages carry their own FAQ — and whatever is
   * passed must be the same object the page renders, or the markup describes
   * questions the visitor cannot see.
   */
  faq?: { q: string; a: string }[];
  /** page title, for the breadcrumb leaf */
  title: string;
  /** page description, reused verbatim by Article */
  description: string;
  /** publication dates for a guide; omitted for other page kinds */
  article?: { published: string; modified: string };
  /**
   * The OG key, which for a service page is `service-<key>` and is the only
   * thing on a service route that says *which* service this is. Used to look
   * the copy up for the `Service` node; ignored for every other kind.
   */
  ogKey?: string;
}
const { locale, dict, path, kind, title, description, article, absolute = false, faq, ogKey } = Astro.props;

const SITE = 'https://exclamationdev.com';
const url = `${SITE}${absolute ? path : localePath(locale, path)}`;
const phone = channels.find((c) => c.key === 'phone')!.value.replace(/\s/g, '');

/**
 * One @graph per page rather than several loose blocks: the nodes reference
 * each other by @id, which only works if they are in the same graph.
 *
 * No AggregateRating and no Review anywhere — there are no reviews, and
 * inventing them is the one structured-data lie that gets a site penalised.
 */
const organization = {
  '@type': 'Organization',
  '@id': ORG_ID,
  name: ORG_NAME,
  alternateName: ORG_ALTERNATE_NAMES,
  url: SITE,
  email: EMAIL,
  telephone: phone,
  foundingDate: '2019',
  ...(SAME_AS.length ? { sameAs: SAME_AS } : {}),
  address: { '@type': 'PostalAddress', ...ADDRESS },
};

/**
 * The site itself as an entity, distinct from the studio that publishes it.
 * Without it the three localised landing pages are three unrelated documents
 * as far as a graph is concerned; with it they are one site in three
 * languages, published by a named organisation.
 *
 * No `potentialAction`/`SearchAction`. There is no search endpoint on this
 * site, and a SearchAction pointing at a URL template that 404s is a claim
 * that a feature exists when it does not.
 */
const website = {
  '@type': 'WebSite',
  '@id': `${SITE}/#website`,
  url: SITE,
  name: ORG_NAME,
  alternateName: ORG_ALTERNATE_NAMES,
  inLanguage: ['az', 'ru', 'en'],
  publisher: { '@id': ORG_ID },
};

const service = {
  '@type': 'ProfessionalService',
  '@id': SERVICE_ID,
  name: ORG_NAME,
  url: SITE,
  parentOrganization: { '@id': ORG_ID },
  email: EMAIL,
  telephone: phone,
  address: { '@type': 'PostalAddress', ...ADDRESS },
  geo: { '@type': 'GeoCoordinates', ...GEO },
  // Both, and in this order: the city is what the commercial queries carry
  // ("sayt hazırlanması Bakı", "разработка сайтов Баку") and the country is
  // the truthful outer bound of where the studio actually takes work.
  areaServed: [
    { '@type': 'City', name: 'Baku', alternateName: ['Bakı', 'Баку'] },
    { '@type': 'Country', name: 'Azerbaijan', identifier: 'AZ' },
  ],
  /**
   * The languages hang off a ContactPoint, not off the service itself:
   * `availableLanguage` is declared on ContactPoint, and schema.org's
   * validator rejects it on ProfessionalService.
   */
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    telephone: phone,
    email: EMAIL,
    availableLanguage: ['az', 'ru', 'en'],
    areaServed: 'AZ',
  },
  knowsAbout: dict.services.items.map((s) => s.title),
};

/**
 * The individual service a service page is about — "web development", not
 * "the studio". `ProfessionalService` above is the business; this is one thing
 * the business sells, and only a service page has one.
 *
 * `description` is the page's own lead sentence, which is written to be
 * quotable whole (see `ServiceCopy.lead`), so the structured data and the
 * first thing a reader sees are the same sentence rather than two paraphrases
 * that can drift apart.
 *
 * NO `offers`, deliberately. An `Offer` is only worth emitting with a `price`
 * or a `priceSpecification`, and this studio publishes no price list anywhere
 * on the site — the FAQ says so in all three languages. A `priceCurrency` with
 * no number, or a number nobody has agreed to, would be structured data making
 * a claim the site does not make. Supply real starting prices and this is the
 * place they go.
 */
const serviceKey = kind === 'service' && ogKey?.startsWith('service-')
  ? ogKey.slice('service-'.length)
  : null;
const thisServiceCopy = serviceKey ? serviceCopy[serviceKey]?.[locale] : null;
const serviceName = thisServiceCopy
  ? thisServiceCopy.titleMuted.replace(/\s*[—–-]\s*$/, '').trim()
  : '';

const serviceOffered = thisServiceCopy
  ? {
      '@type': 'Service',
      '@id': `${url}#offering`,
      // `titleMuted` is the service noun and `titleMain` the tagline that
      // finishes the H1 — "Veb sayt hazırlanması —" then "sürətli, çoxdilli,
      // sizin." Only the first half names the thing being sold, and it is the
      // half that matches what people search for, so the tagline is dropped
      // and the dash it hands over to the second half goes with it.
      name: serviceName,
      serviceType: serviceName,
      description: thisServiceCopy.lead,
      url,
      // No `inLanguage` here: schema.org declares it on CreativeWork and its
      // subtypes, and Service is not one of them. `scripts/schema-check.mjs`
      // rejects it. The page's language is already stated by <html lang> and
      // by the WebSite node.
      provider: { '@id': SERVICE_ID },
      areaServed: [
        { '@type': 'City', name: 'Baku', alternateName: ['Bakı', 'Баку'] },
        { '@type': 'Country', name: 'Azerbaijan', identifier: 'AZ' },
      ],
    }
  : null;

/**
 * Built from `dict.faq`, the same object the accordion renders, so the
 * question and answer strings are identical to the visible text by
 * construction rather than by somebody remembering to update both.
 */
const questions = faq ?? (kind === 'home' ? dict.faq.items : null);

const faqPage =
  questions
    ? {
        '@type': 'FAQPage',
        '@id': `${url}#faq`,
        inLanguage: locale,
        mainEntity: questions.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: { '@type': 'Answer', text: item.a },
        })),
      }
    : null;

const breadcrumb =
  kind === 'home'
    ? null
    : {
        '@type': 'BreadcrumbList',
        '@id': `${url}#breadcrumb`,
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: ORG_NAME,
            item: `${SITE}${localePath(locale, '/')}`,
          },
          { '@type': 'ListItem', position: 2, name: title, item: url },
        ],
      };

const articleNode =
  kind === 'guide' && article
    ? {
        '@type': 'Article',
        '@id': `${url}#article`,
        headline: title,
        description,
        url,
        mainEntityOfPage: { '@id': url },
        inLanguage: locale,
        datePublished: article.published,
        dateModified: article.modified,
        image: `${SITE}/og/${ogKey}-${locale}.png`,
        author: { '@id': ORG_ID },
        publisher: { '@id': ORG_ID },
        isPartOf: { '@id': `${SITE}/#website` },
      }
    : null;

const graph = [organization, website, service, serviceOffered, articleNode, faqPage, breadcrumb].filter(Boolean);
const json = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---

<script type="application/ld+json" is:inline set:html={json} />
