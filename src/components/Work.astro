---
import CaseCard from './CaseCard.astro';
import Icon from './Icon.astro';
import { localePath, type Dict, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  dict: Dict;
}
const { locale, dict } = Astro.props;
const w = dict.work;

/**
 * The landing section shows six and then hands over to `/is/`.
 *
 * It is a glance, not the archive: a seventh card pushes the grid past what
 * anyone scrolls through on the way to the contact form, and the lead card
 * stops leading. The full list lives on the index page, where it can be
 * grouped and read properly.
 *
 * `titleMuted` spells the six as a word in three languages, which cannot be
 * computed — so the count is pinned here instead, and adding cases moves them
 * onto the index page without touching the heading.
 */
const LANDING = 6;
if (dict.cases.length < LANDING) {
  throw new Error(
    `work: the section shows ${LANDING} cases but only ${dict.cases.length} exist. ` +
      `Lower LANDING and correct the spelled-out count in work.titleMuted ("${w.titleMuted}").`
  );
}

const [lead, ...rest] = dict.cases.slice(0, LANDING);
---

<section class="work" id="work" aria-labelledby="work-title">
  <div class="shell">
    <header class="work-head">
      <p class="mono">{w.eyebrow}</p>
      <h2 id="work-title" data-reveal>
        <span class="muted">{w.titleMuted}</span> {w.titleMain}
      </h2>
    </header>

    <div class="case-lead" data-reveal>
      <CaseCard locale={locale} dict={dict} slug={lead.slug} variant="lead" />
    </div>

    <ul class="case-grid">
      {rest.map((c) => (
        <li data-reveal>
          <CaseCard locale={locale} dict={dict} slug={c.slug} />
        </li>
      ))}
    </ul>

    <p class="work-all" data-reveal>
      <a href={localePath(locale, '/is')}>
        {w.all}<span class="work-all-arrow"><Icon name="arrow-right" size={16} /></span>
      </a>
    </p>
  </div>
</section>

<style>
  .work {
    position: relative;
    z-index: 1;
    padding-block: var(--sp-chapter);
    border-top: 1px solid var(--line);
  }

  .work-head {
    padding-left: var(--rail);
    margin-bottom: var(--sp-section);
  }
  .work-head h2 {
    margin-top: 1rem;
    font-size: var(--fs-600);
    font-weight: 300;
    max-width: 20ch;
  }
  .work-head h2 .muted {
    color: var(--fg-muted);
  }

  .case-lead {
    margin-left: var(--rail);
  }

  .case-grid {
    display: grid;
    gap: var(--sp-section) clamp(1rem, 2.5vw, 2rem);
    margin-top: var(--sp-section);
    margin-left: var(--rail);
  }
  @media (min-width: 640px) {
    .case-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .case-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* the handover to the archive, in the same typographic register as the case
     name itself — an underline and an arrow, no button */
  .work-all {
    margin-top: var(--sp-section);
    margin-left: var(--rail);
  }
  /* inline-flex with a 44px box: as a bare inline link the hit area measured
     22px high and the harness failed it on all twelve viewports */
  .work-all a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: var(--fs-400);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition: color 140ms var(--ease), text-decoration-color 140ms var(--ease);
  }
  .work-all-arrow {
    display: inline-block;
    margin-left: 0.4em;
    vertical-align: -0.12em;
    color: var(--fg-muted);
    transition: color 140ms var(--ease);
  }
  @media (hover: hover) {
    .work-all a:hover {
      color: var(--accent);
      text-decoration-color: var(--accent);
    }
    .work-all a:hover .work-all-arrow {
      color: var(--accent);
    }
  }
</style>
