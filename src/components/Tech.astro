---
import { techCats, techCount, techMain } from '../data/tech';
import type { Dict } from '../i18n';

/**
 * One line, with the full list one click behind it.
 *
 * This was six columns of names — forty of them — filling an inverted screen.
 * Cut to a line on 2026-08-09. The full list is kept rather than deleted,
 * because this is the only place on the site that carries it: the service
 * pages each list their own four groups, so between them they do not add up
 * to the stack, and nothing else enumerates it.
 *
 * A native <details> is what keeps both: the section reads as one line, and
 * the forty are still there, in the markup, for the reader who wants them and
 * for anything crawling the page. No JavaScript.
 *
 * `id="tech"` stays — the nav links to it and LegacyHash leaves it alone.
 */
interface Props {
  dict: Dict;
}
const { dict } = Astro.props;
const s = dict.tech;
---

<section class="tech invert" id="tech" aria-labelledby="tech-title">
  {/* the page's spine is painted over by this section's ground, so it is
      redrawn here in the inverted --line and stays unbroken */}
  <div class="spine-wrap" aria-hidden="true">
    <div class="shell spine-shell"><span class="spine"></span></div>
  </div>

  <div class="shell tech-in">
    <h2 class="mono tech-eyebrow" id="tech-title" data-reveal>{s.eyebrow}</h2>

    <p class="tech-line" data-reveal>
      {/* lang="en": CSS uppercase and hyphenation follow the document
          language, and these are English product names on all three */}
      <span class="tech-main" lang="en">{techMain.join(' · ')}</span>
      <span class="tech-note">{s.line}</span>
    </p>

    <details class="tech-all" data-reveal>
      <summary>
        <span class="mono tech-summary-label">{s.expand}</span>
        <span class="mono tech-summary-n num">{techCount} {s.countLabel}</span>
      </summary>
      <div class="tech-cats">
        {techCats.map((cat) => (
          <div class="tech-cat">
            <h3 class="tech-cat-name mono" lang="en">{cat.name}</h3>
            <ul class="tech-items" lang="en">
              {cat.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </details>
  </div>
</section>

<style>
  /* still the one inverted section, but a band now rather than a screen.
     .invert (tokens.css) re-derives the role tokens against that ground. */
  .tech {
    position: relative;
    z-index: 1;
    padding-block: var(--sp-section);
    background: var(--bg);
    color: var(--fg);
  }
  .tech-in {
    padding-left: var(--rail);
  }

  .tech-eyebrow {
    margin-bottom: var(--sp-block);
    font-weight: 400;
  }

  .tech-line {
    max-width: 68ch;
    font-size: var(--fs-300);
    line-height: 1.6;
  }
  /* the product names carry the line; the caveat after them recedes */
  .tech-main {
    font-family: var(--font-mono);
    letter-spacing: 0.01em;
  }
  .tech-note {
    display: block;
    margin-top: 0.6em;
    color: var(--fg-muted);
  }

  .tech-all {
    margin-top: var(--sp-block);
    border-top: 1px solid var(--line);
  }
  .tech-all summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    /* 44px from the padding plus the line box */
    padding-block: 0.8125rem;
    cursor: pointer;
    list-style: none;
    color: var(--fg-muted);
    transition: color 140ms var(--ease);
  }
  .tech-all summary::-webkit-details-marker {
    display: none;
  }
  .tech-all summary:focus-visible {
    outline-offset: -2px;
  }
  @media (hover: hover) {
    .tech-all summary:hover {
      color: var(--fg);
    }
  }
  .tech-summary-label {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.22em;
  }

  .tech-cats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-block) clamp(1rem, 2.5vw, 2rem);
    padding-block: var(--sp-block);
  }
  @media (min-width: 900px) {
    .tech-cats {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
  .tech-cat-name {
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
    color: var(--fg-muted);
  }
  .tech-items {
    margin-top: 0.875rem;
    font-family: var(--font-mono);
    font-size: var(--fs-200);
    line-height: 1.4;
  }
  .tech-items li + li {
    margin-top: 0.5rem;
  }
</style>
