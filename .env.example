# Formspree form id — the part after /f/ in the endpoint URL.
# The real value is not committed; set it here locally and in the
# Cloudflare Pages build environment.
FORMSPREE_ID=xxxxxxxx

# Cloudflare Turnstile site key. Left empty until the deploy step:
# with no key the widget slot renders nothing and the form still submits.
TURNSTILE_SITE_KEY=
